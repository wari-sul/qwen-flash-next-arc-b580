[Unit]
Description=Strata API :8081 (Qwen3.8-Flash-Next GSQ-RCO Coder IQ1_M, Arc B580, 256K, MTP) - lazy load, unloads :8080 first
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=LANG=en_US.UTF-8
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
LimitMEMLOCK=infinity
ExecStart=/root/.local/bin/strata serve --profile /etc/strata/coder-iq1m-256k.json --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
